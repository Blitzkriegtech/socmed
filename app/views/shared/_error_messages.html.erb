<% if @user.errors.any? %>
  <div class="mb-4 p-4 bg-red-30 border border-red-200 rounded-md">
    <h3 class="text-sm font-medium text-red-500 mb-2">
      INVALID SIGNUP INFO, FOUND
      <%= pluralize(@user.errors.count, "error").upcase %>
    </h3>
    <ul class="list-disc list-inside text-sm text-red-600 space-y-1">
      <% @user.errors.full_messages.each do |err_msg| %>
        <li class="error-item"><%= err_msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>